// FlockSteering.compute — GPU steering pipeline for Bird_behiviour.
//
// PHASES (this file evolves with the GPU rewrite):
//   P1 (now)  : HashPass + brute-force SteeringAndIntegratePass + MatricesPass.
//               Single flock, no cursor / bounds / perception cone. Establishes
//               buffer wiring + render path. O(N²) — useful as floor-perf reference.
//   P2 (next) : Add CellStartPass; SteeringPass switches to 27-cell walk consuming
//               BitonicSort.compute's sorted (cellId, boidId) buffer.
//   P3        : Multi-flock (FlockSettingsGpu buffer indexed by Boid.flockId), bounds,
//               cursor, perception cone.
//   P4        : FrustumCullPass writes per-flock indirect-args buffers.
//   P5        : Topological-K=8 inner loop in SteeringPass.
//   P6        : Temporal-coherence — SteeringPass split into Discovery+Apply stages.
//   P7        : Per-bird self-occlusion cull (Lages 2009).
//
// BOID STRUCT — must match Compute/BoidGpu.cs byte-for-byte. 48 bytes, 16-byte
// aligned. Apple GPU prefers 16B reads; un-aligned reads silently halve throughput.
//
// THREADGROUP SIZE — 64. Apple GPU best-practices doc (Apple tech-talk 111373)
// recommends 64-thread groups for simple, divergence-free kernels. Larger groups
// increase register pressure on the M-series GPU's per-core simdgroup limit (24
// simdgroups/core on Apple Family 9 / M3+).

#pragma kernel CSHash
#pragma kernel CSSteerBruteForce
#pragma kernel CSClearCellStart
#pragma kernel CSCellStart
#pragma kernel CSSteerCellList
#pragma kernel CSSteerTopoK
#pragma kernel CSBuildMatrices

// ── Boid struct (mirror of Compute/BoidGpu.cs) ────────────────────────────────
struct Boid
{
    float3 pos;
    uint   flockId;
    float3 vel;
    float  pad0;
    float4 reserved;
};

// ── FlockKernelSettings struct (mirror of Compute/FlockSettingsGpu.cs) ────────
// 96 bytes, 16-byte aligned. Indexed by Boid.flockId.
struct FlockKernelSettings
{
    float3 color;                       float perceptionRadius;
    float  separationRadius;            float perceptionConeCos;
    float  minSpeed;                    float maxSpeed;
    float  maxAcceleration;
    float  inSepW;                      float inAliW;             float inCohW;
    float  outSepW;                     float outAliW;            float outCohW;
    float  cursorReactionStrength;
    float  cursorReactionRadius;        float3 preferredCenter;
    float  preferredAttractionWeight;   float3 preferredExtents;
};

// ── Buffers ────────────────────────────────────────────────────────────────────
RWStructuredBuffer<Boid>                _Boids;        // R+W per tick
RWStructuredBuffer<uint2>               _CellKeys;     // (cellId, boidId) — written by CSHash, sorted by BitonicSort.compute (P2)
RWStructuredBuffer<uint>                _CellStart;    // cellStart[cellId] = first index in _CellKeys that has that cellId; 0xFFFFFFFF when empty
RWStructuredBuffer<float4x4>            _Matrices;     // written by CSBuildMatrices, consumed by RenderMeshIndirect
StructuredBuffer<FlockKernelSettings>   _FlockSettings; // P3: indexed by Boid.flockId. Read-only per tick.

// CellStart sentinel: any read >= _PaddedKeyCount means "no birds in that cell".
// We use _PaddedKeyCount itself (not 0xFFFFFFFF) as the sentinel because the
// reset kernel can write it via a single SetInt'd uint and the SteeringPass
// already has _PaddedKeyCount in scope as the iteration upper bound for cellEnd
// (so two cells in a row produce the right empty-cell behaviour without a
// special-case branch).
uint _PaddedKeyCount;     // = next power of two ≥ _BirdCount (size of _CellKeys)
uint _CellTotalCount;     // = _GridDim.x * _GridDim.y * _GridDim.z (size of _CellStart)

// ── Per-tick constants (pushed by GpuFlockSimulation each Tick) ───────────────
uint  _BirdCount;        // live element count (≤ buffer length)
float _Dt;               // simulation step seconds

// World-grid params (used by CSHash; SteeringPass uses them in P2+).
float3 _WorldOrigin;     // bottom-back-left corner of the spatial grid
float  _CellSize;        // cell edge length (= max perception radius across flocks)
uint3  _GridDim;         // cells per axis

// Single-flock steering params kept for the legacy CSSteerBruteForce + CSSteerCellList
// kernels (P1/P2 paths). CSSteerTopoK (P5+) reads from _FlockSettings instead.
float _PerceptionRadius;
float _SeparationRadius;
float _MinSpeed;
float _MaxSpeed;
float _MaxAcceleration;
float _SepWeight;
float _AliWeight;
float _CohWeight;
float3 _PreferredCenter;
float3 _PreferredExtents;
float  _PreferredAttractionWeight;

// ── P3 world-scoped constants ───────────────────────────────────────────────
// Hard world bounds (sharp inward push outside extents). Per-flock soft
// "preferred zone" is in FlockKernelSettings; the world hard bounds is
// global because every flock shares the same physical world container.
float3 _WorldBoundsCenter;
float3 _WorldBoundsExtents;
float  _WorldBoundsWeight;
float  _WorldBoundsMargin;

// Cursor — world-space position of the player's pointer + a flag whether
// the cursor was successfully projected onto the horizontal plane this tick.
float3 _CursorWorldPoint;
uint   _CursorOnScreen; // 0 or 1; bool-like for SetInt

// ── Hash helpers ──────────────────────────────────────────────────────────────
//
// P2 grid: a flat index x + y*Gx + z*Gx*Gy. Cells outside the grid are clamped
// to the boundary cell. This bounds _CellStart's size at gridDim.x*y*z (~4000
// for our default 50×25×50 world with 5-unit cells), which is small enough that
// CSClearCellStart is a single dispatch and CSCellStart can write at random.
//
// We use a flat grid (not Teschner's hash-table-with-collisions) because at our
// scale the grid IS the hash table — collisions are zero, and the SteeringPass
// doesn't need to filter spurious neighbours from collided cells.
int3 WorldToCell(float3 pos)
{
    int3 c = (int3)floor((pos - _WorldOrigin) / _CellSize);
    return clamp(c, int3(0, 0, 0), int3(_GridDim) - int3(1, 1, 1));
}

uint FlatCellId(int3 cell)
{
    return (uint)cell.x + (uint)cell.y * _GridDim.x + (uint)cell.z * _GridDim.x * _GridDim.y;
}

// ──────────────────────────────────────────────────────────────────────────────
// CSHash — one thread per bird. Writes (cellId, boidId) to _CellKeys.
// BitonicSort.compute then sorts by .x (cellId), so birds within the same cell
// become contiguous in _CellKeys for the P2 SteeringPass to walk.
// ──────────────────────────────────────────────────────────────────────────────
[numthreads(64, 1, 1)]
void CSHash(uint3 tid : SV_DispatchThreadID)
{
    uint i = tid.x;
    // Live birds get their cell id; padded tail [_BirdCount, _PaddedKeyCount) gets
    // the sentinel (0xFFFFFFFF, 0xFFFFFFFF) so BitonicSort's ascending sort drops
    // them at the end of _CellKeys where CSCellStart will ignore them.
    if (i >= _PaddedKeyCount) return;
    if (i >= _BirdCount)
    {
        _CellKeys[i] = uint2(0xFFFFFFFFu, 0xFFFFFFFFu);
        return;
    }

    Boid b = _Boids[i];
    int3 cell = WorldToCell(b.pos);
    uint h = FlatCellId(cell);
    _CellKeys[i] = uint2(h, i);
}

// ──────────────────────────────────────────────────────────────────────────────
// CSClearCellStart — one thread per grid cell. Resets _CellStart to the "empty"
// sentinel before each tick's CSCellStart pass.
//
// Sentinel value is _PaddedKeyCount (the live-key range upper bound). When
// CSSteerCellList reads _CellStart[c] and gets a value >= _PaddedKeyCount, it
// treats that cell as empty without a special branch — the cell-walk loop's
// "for (uint k = start; k < end; ++k)" naturally short-circuits because
// start == end at the empty sentinel.
// ──────────────────────────────────────────────────────────────────────────────
[numthreads(64, 1, 1)]
void CSClearCellStart(uint3 tid : SV_DispatchThreadID)
{
    uint c = tid.x;
    if (c >= _CellTotalCount) return;
    _CellStart[c] = _PaddedKeyCount;
}

// ──────────────────────────────────────────────────────────────────────────────
// CSCellStart — one thread per element of (sorted) _CellKeys. Writes the index
// of the FIRST occurrence of each cellId into _CellStart[cellId]. Race-free
// because each cellId is written by exactly one thread (whichever has the
// lowest .x for that cellId).
//
// The "end" of cell c is implied: it's the start of the next non-empty cell.
// CSSteerCellList walks until cellKeys[k].x changes (rather than relying on a
// separate cellEnd array). This keeps the cell table at one buffer instead of
// two and saves ~20% memory on the spatial structure.
// ──────────────────────────────────────────────────────────────────────────────
[numthreads(64, 1, 1)]
void CSCellStart(uint3 tid : SV_DispatchThreadID)
{
    uint i = tid.x;
    if (i >= _PaddedKeyCount) return;

    uint thisCell = _CellKeys[i].x;
    if (thisCell == 0xFFFFFFFFu) return; // padded tail — skip

    if (i == 0u)
    {
        _CellStart[thisCell] = i;
    }
    else
    {
        uint prevCell = _CellKeys[i - 1u].x;
        if (thisCell != prevCell)
        {
            _CellStart[thisCell] = i;
        }
    }
}

// ──────────────────────────────────────────────────────────────────────────────
// CSSteerCellList — P2 hot path. Each thread reads its bird, walks the 27-cell
// neighbourhood via _CellStart, accumulates separation/alignment/cohesion +
// soft preferred-zone, integrates, writes back.
//
// The 27-cell loop is unrolled for branch coherence — every thread visits the
// same cells, just possibly with different cellStart values. Per-cell inner
// loop walks until cellKeys[k].x changes (the implicit cellEnd marker).
// ──────────────────────────────────────────────────────────────────────────────
[numthreads(64, 1, 1)]
void CSSteerCellList(uint3 tid : SV_DispatchThreadID)
{
    uint i = tid.x;
    if (i >= _BirdCount) return;

    Boid me = _Boids[i];
    float3 selfPos = me.pos;
    float3 selfVel = me.vel;

    int3 myCell = WorldToCell(selfPos);

    float perceptSq = _PerceptionRadius * _PerceptionRadius;
    float sepRSq    = _SeparationRadius * _SeparationRadius;

    float3 sepAccum = float3(0, 0, 0);
    float3 aliSum   = float3(0, 0, 0);
    float3 cohSum   = float3(0, 0, 0);
    uint   nCount   = 0;

    [unroll] for (int dz = -1; dz <= 1; ++dz)
    {
        [unroll] for (int dy = -1; dy <= 1; ++dy)
        {
            [unroll] for (int dx = -1; dx <= 1; ++dx)
            {
                int3 cell = myCell + int3(dx, dy, dz);
                // Bounds check — birds against the world wall don't have full neighbourhoods.
                if (cell.x < 0 || cell.y < 0 || cell.z < 0 ||
                    cell.x >= (int)_GridDim.x || cell.y >= (int)_GridDim.y || cell.z >= (int)_GridDim.z)
                {
                    continue;
                }

                uint cid = FlatCellId(cell);
                uint start = _CellStart[cid];
                if (start >= _PaddedKeyCount) continue; // empty cell

                // Walk forward in _CellKeys until cellId changes.
                for (uint k = start; k < _PaddedKeyCount; ++k)
                {
                    uint2 entry = _CellKeys[k];
                    if (entry.x != cid) break;

                    uint j = entry.y;
                    if (j == i) continue;

                    Boid nb = _Boids[j];
                    float3 toN = nb.pos - selfPos;
                    float distSq = dot(toN, toN);
                    if (distSq > perceptSq || distSq <= 1e-12f) continue;

                    if (distSq < sepRSq)
                    {
                        float invD = rsqrt(distSq);
                        float dist = distSq * invD;
                        float fall = 1.0f - dist / _SeparationRadius;
                        sepAccum -= toN * (invD * fall);
                    }

                    aliSum += nb.vel;
                    cohSum += nb.pos;
                    nCount++;
                }
            }
        }
    }

    // Reynolds alignment + cohesion (zero-neighbour fallback returns zero).
    float3 ali = float3(0, 0, 0);
    float3 coh = float3(0, 0, 0);
    if (nCount > 0u)
    {
        float invN = 1.0f / (float)nCount;
        float3 avgVel = aliSum * invN;
        float avgVelSq = dot(avgVel, avgVel);
        if (avgVelSq > 1e-12f)
        {
            float3 desired = avgVel * rsqrt(avgVelSq) * _MaxSpeed;
            ali = (desired - selfVel);
        }
        float3 cohCentroid = cohSum * invN;
        coh = cohCentroid - selfPos;
    }

    // Soft preferred-zone pull.
    float3 off = selfPos - _PreferredCenter;
    float3 over = max(abs(off) - _PreferredExtents, float3(0, 0, 0));
    float overMag = length(over);
    float3 boundsForce = float3(0, 0, 0);
    if (overMag > 1e-6f)
    {
        float dist = length(off);
        float maxExtent = max(max(_PreferredExtents.x, _PreferredExtents.y), max(_PreferredExtents.z, 1e-3f));
        float falloff = saturate(1.0f - dist / maxExtent);
        float3 dir = (dist > 1e-6f) ? -off / dist : float3(0, 0, 0);
        boundsForce = dir * (overMag * _PreferredAttractionWeight * (1.0f - falloff * 0.5f));
    }

    float3 a = sepAccum * _SepWeight + ali * _AliWeight + coh * _CohWeight + boundsForce;

    // Cap acceleration.
    float maxASq = _MaxAcceleration * _MaxAcceleration;
    float aSq = dot(a, a);
    if (aSq > maxASq && aSq > 0.0f)
    {
        a = a * (_MaxAcceleration * rsqrt(aSq));
    }

    // Integrate, clamp speed.
    float3 vel = selfVel + a * _Dt;
    float speedSq = dot(vel, vel);
    float minSq = _MinSpeed * _MinSpeed;
    float maxSq = _MaxSpeed * _MaxSpeed;
    if (speedSq > maxSq && speedSq > 0.0f)
    {
        vel = vel * (_MaxSpeed * rsqrt(speedSq));
    }
    else if (speedSq < minSq)
    {
        if (speedSq > 1e-12f)
        {
            vel = vel * (_MinSpeed * rsqrt(speedSq));
        }
        else
        {
            vel = float3(0, 0, _MinSpeed);
        }
    }

    me.vel = vel;
    me.pos = selfPos + vel * _Dt;
    _Boids[i] = me;
}

// ──────────────────────────────────────────────────────────────────────────────
// CSSteerBruteForce — P1 reference path. Each thread sums forces from EVERY
// other bird (O(N²)). Useful as the floor-perf bench and to validate the buffer
// wiring before P2 (spatial hash) replaces the inner loop with a 27-cell walk.
//
// Branch shape: zero divergence — every thread runs the same loop. Apple GPU
// loves this kernel; warps stay coherent. The cost scales quadratically in N,
// so brute-force tops out near 50k on M4 Max before becoming the bottleneck.
// ──────────────────────────────────────────────────────────────────────────────
[numthreads(64, 1, 1)]
void CSSteerBruteForce(uint3 tid : SV_DispatchThreadID)
{
    uint i = tid.x;
    if (i >= _BirdCount) return;

    Boid me = _Boids[i];
    float3 selfPos = me.pos;
    float3 selfVel = me.vel;

    float perceptSq = _PerceptionRadius * _PerceptionRadius;
    float sepRSq    = _SeparationRadius * _SeparationRadius;

    float3 sepAccum = float3(0, 0, 0);
    float3 aliSum   = float3(0, 0, 0);
    float3 cohSum   = float3(0, 0, 0);
    uint   nCount   = 0;

    for (uint j = 0; j < _BirdCount; j++)
    {
        if (j == i) continue;
        Boid nb = _Boids[j];
        float3 toN = nb.pos - selfPos;
        float distSq = dot(toN, toN);
        if (distSq > perceptSq || distSq <= 1e-12f) continue;

        // Separation (per-pair) — only neighbours inside SeparationRadius.
        if (distSq < sepRSq)
        {
            float invD = rsqrt(distSq);
            float dist = distSq * invD;
            float fall = 1.0f - dist / _SeparationRadius;
            sepAccum -= toN * (invD * fall);
        }

        aliSum += nb.vel;
        cohSum += nb.pos;
        nCount++;
    }

    // Reynolds alignment + cohesion (zero-neighbour fallback returns zero).
    float3 ali = float3(0, 0, 0);
    float3 coh = float3(0, 0, 0);
    if (nCount > 0u)
    {
        float invN = 1.0f / (float)nCount;
        float3 avgVel = aliSum * invN;
        float avgVelSq = dot(avgVel, avgVel);
        if (avgVelSq > 1e-12f)
        {
            float3 desired = avgVel * rsqrt(avgVelSq) * _MaxSpeed;
            ali = (desired - selfVel);
        }
        float3 cohCentroid = cohSum * invN;
        coh = cohCentroid - selfPos;
    }

    // Soft preferred-zone pull — gentle attraction back into the box.
    float3 off = selfPos - _PreferredCenter;
    float3 over = max(abs(off) - _PreferredExtents, float3(0, 0, 0));
    float overMag = length(over);
    float3 boundsForce = float3(0, 0, 0);
    if (overMag > 1e-6f)
    {
        float dist = length(off);
        float maxExtent = max(max(_PreferredExtents.x, _PreferredExtents.y), max(_PreferredExtents.z, 1e-3f));
        float falloff = saturate(1.0f - dist / maxExtent);
        float3 dir = (dist > 1e-6f) ? -off / dist : float3(0, 0, 0);
        boundsForce = dir * (overMag * _PreferredAttractionWeight * (1.0f - falloff * 0.5f));
    }

    float3 a = sepAccum * _SepWeight + ali * _AliWeight + coh * _CohWeight + boundsForce;

    // Cap acceleration via normalize-safe pattern (length² compare).
    float maxASq = _MaxAcceleration * _MaxAcceleration;
    float aSq = dot(a, a);
    if (aSq > maxASq && aSq > 0.0f)
    {
        a = a * (_MaxAcceleration * rsqrt(aSq));
    }

    // Integrate velocity, clamp speed range.
    float3 vel = selfVel + a * _Dt;
    float speedSq = dot(vel, vel);
    float minSq = _MinSpeed * _MinSpeed;
    float maxSq = _MaxSpeed * _MaxSpeed;
    if (speedSq > maxSq && speedSq > 0.0f)
    {
        vel = vel * (_MaxSpeed * rsqrt(speedSq));
    }
    else if (speedSq < minSq)
    {
        if (speedSq > 1e-12f)
        {
            vel = vel * (_MinSpeed * rsqrt(speedSq));
        }
        else
        {
            vel = float3(0, 0, _MinSpeed);
        }
    }

    me.vel = vel;
    me.pos = selfPos + vel * _Dt;
    _Boids[i] = me;
}

// ──────────────────────────────────────────────────────────────────────────────
// CSSteerTopoK — P5 hot path. Same 27-cell walk as CSSteerCellList, but the
// inner loop only retains the K=8 NEAREST neighbours found during the walk
// (via a register-resident insertion-sorted K-array), then accumulates forces
// from only those K. This bounds per-bird cost regardless of cell density —
// 100k birds in a 50³ box become as cheap per-bird as 20k birds.
//
// Why K=8: Ballerini et al. 2008 (PNAS 105(4)) found via field-tracking 3D
// data that real starlings interact with 6-7 topological neighbours regardless
// of distance. K=8 leaves a small margin for sparse populations where some of
// the K slots stay invalid. Empirically the visual character of the flock is
// indistinguishable from the metric path under a close-camera observer.
//
// Memory: K=8 * (uint id + float sqDist) = 64 B per thread. Apple GPU register
// file accommodates this comfortably at 64 threads/group. The insertion sort
// is bounded by K iterations and unrolls cleanly under [loop] hint.
// ──────────────────────────────────────────────────────────────────────────────
[numthreads(64, 1, 1)]
void CSSteerTopoK(uint3 tid : SV_DispatchThreadID)
{
    uint i = tid.x;
    if (i >= _BirdCount) return;

    Boid me = _Boids[i];
    float3 selfPos = me.pos;
    float3 selfVel = me.vel;
    uint   selfFlock = me.flockId;
    FlockKernelSettings s = _FlockSettings[selfFlock];

    int3 myCell = WorldToCell(selfPos);
    float perceptSq = s.perceptionRadius * s.perceptionRadius;

    // Pre-compute selfVel info for the perception cone test.
    float speedSq = dot(selfVel, selfVel);
    bool  hasHeading = (speedSq > 1e-8f);

    // K-NN state — register-resident.
    const uint KMAX = 8;
    uint  knnIds[KMAX];
    float knnSqDist[KMAX];
    [unroll] for (uint kk = 0; kk < KMAX; ++kk)
    {
        knnIds[kk]    = 0xFFFFFFFFu;
        knnSqDist[kk] = 1e30f;
    }

    // 27-cell walk — gather K-NN candidates that pass the perception cone test.
    [unroll] for (int dz = -1; dz <= 1; ++dz)
    {
        [unroll] for (int dy = -1; dy <= 1; ++dy)
        {
            [unroll] for (int dx = -1; dx <= 1; ++dx)
            {
                int3 cell = myCell + int3(dx, dy, dz);
                if (cell.x < 0 || cell.y < 0 || cell.z < 0 ||
                    cell.x >= (int)_GridDim.x || cell.y >= (int)_GridDim.y || cell.z >= (int)_GridDim.z)
                {
                    continue;
                }

                uint cid = FlatCellId(cell);
                uint start = _CellStart[cid];
                if (start >= _PaddedKeyCount) continue;

                for (uint k = start; k < _PaddedKeyCount; ++k)
                {
                    uint2 entry = _CellKeys[k];
                    if (entry.x != cid) break;

                    uint j = entry.y;
                    if (j == i) continue;

                    float3 nbPos = _Boids[j].pos;
                    float3 toN = nbPos - selfPos;
                    float distSq = dot(toN, toN);
                    if (distSq > perceptSq || distSq <= 1e-12f) continue;

                    // Perception cone test: dot(unit selfVel, unit toN) >= cosHalfAngle.
                    // Skipped when bird is motionless (360° fallback).
                    if (hasHeading)
                    {
                        float dotRaw = dot(selfVel, toN);
                        float invLens = rsqrt(speedSq * distSq);
                        float cosTheta = dotRaw * invLens;
                        if (cosTheta < s.perceptionConeCos) continue;
                    }

                    // Insert into K-NN if closer than the current K-th element.
                    if (distSq < knnSqDist[KMAX - 1u])
                    {
                        uint pos = KMAX - 1u;
                        [unroll] for (uint shift = 0; shift < KMAX - 1u; ++shift)
                        {
                            uint p = KMAX - 1u - shift;
                            if (p > 0u && knnSqDist[p - 1u] > distSq)
                            {
                                knnSqDist[p] = knnSqDist[p - 1u];
                                knnIds[p]    = knnIds[p - 1u];
                                pos = p - 1u;
                            }
                            else
                            {
                                pos = p;
                                break;
                            }
                        }
                        knnSqDist[pos] = distSq;
                        knnIds[pos]    = j;
                    }
                }
            }
        }
    }

    // Accumulate forces — split in/out of flock so the cross-flock weight branch
    // happens once per K-NN slot (cheap), not per candidate (expensive).
    float sepRSq = s.separationRadius * s.separationRadius;

    float3 sepIn  = float3(0, 0, 0);  float3 aliInS  = float3(0, 0, 0);  float3 cohInS  = float3(0, 0, 0);  uint countIn  = 0;
    float3 sepOut = float3(0, 0, 0);  float3 aliOutS = float3(0, 0, 0);  float3 cohOutS = float3(0, 0, 0);  uint countOut = 0;

    [unroll] for (uint kk2 = 0; kk2 < KMAX; ++kk2)
    {
        if (knnIds[kk2] == 0xFFFFFFFFu) break;
        Boid nb = _Boids[knnIds[kk2]];
        float distSq = knnSqDist[kk2];
        bool sameFlock = (nb.flockId == selfFlock);

        // Per-pair separation contribution.
        float3 sepContrib = float3(0, 0, 0);
        if (distSq < sepRSq)
        {
            float3 toN = nb.pos - selfPos;
            float invD = rsqrt(distSq);
            float dist = distSq * invD;
            float fall = 1.0f - dist / s.separationRadius;
            sepContrib = -toN * (invD * fall);
        }

        if (sameFlock)
        {
            sepIn  += sepContrib;
            aliInS += nb.vel;
            cohInS += nb.pos;
            countIn++;
        }
        else
        {
            sepOut += sepContrib;
            aliOutS += nb.vel;
            cohOutS += nb.pos;
            countOut++;
        }
    }

    // Reynolds alignment + cohesion folded through the in/out branch.
    float3 ali = float3(0, 0, 0);
    float3 coh = float3(0, 0, 0);
    if (countIn > 0u)
    {
        float invN = 1.0f / (float)countIn;
        float3 avgVel = aliInS * invN;
        float aSqv = dot(avgVel, avgVel);
        float3 aliIn = (aSqv > 1e-12f) ? ((avgVel * rsqrt(aSqv) * s.maxSpeed) - selfVel) : float3(0, 0, 0);
        float3 cohIn = (cohInS * invN) - selfPos;
        ali += aliIn * s.inAliW;
        coh += cohIn * s.inCohW;
    }
    if (countOut > 0u)
    {
        float invN = 1.0f / (float)countOut;
        float3 avgVel = aliOutS * invN;
        float aSqv = dot(avgVel, avgVel);
        float3 aliOut = (aSqv > 1e-12f) ? ((avgVel * rsqrt(aSqv) * s.maxSpeed) - selfVel) : float3(0, 0, 0);
        float3 cohOut = (cohOutS * invN) - selfPos;
        ali += aliOut * s.outAliW;
        coh += cohOut * s.outCohW;
    }
    float3 sep = sepIn * s.inSepW + sepOut * s.outSepW;

    // Soft per-flock preferred-zone pull.
    float3 boundsForce = float3(0, 0, 0);
    {
        float3 off = selfPos - s.preferredCenter;
        float3 over = max(abs(off) - s.preferredExtents, float3(0, 0, 0));
        float overMag = length(over);
        if (overMag > 1e-6f)
        {
            float dist = length(off);
            float maxExtent = max(max(s.preferredExtents.x, s.preferredExtents.y), max(s.preferredExtents.z, 1e-3f));
            float falloff = saturate(1.0f - dist / maxExtent);
            float3 dir = (dist > 1e-6f) ? -off / dist : float3(0, 0, 0);
            boundsForce = dir * (overMag * s.preferredAttractionWeight * (1.0f - falloff * 0.5f));
        }
    }

    // World hard-bounds inward push (per the CPU ComputeBoundsForceWorldHard).
    float3 hardBounds = float3(0, 0, 0);
    {
        float3 effExt = max(_WorldBoundsExtents - float3(_WorldBoundsMargin, _WorldBoundsMargin, _WorldBoundsMargin), float3(0, 0, 0));
        float3 off = selfPos - _WorldBoundsCenter;
        float3 over = max(abs(off) - effExt, float3(0, 0, 0)) * sign(off);
        hardBounds = -over * _WorldBoundsWeight;
    }

    // Cursor force — signed reaction with smoothstep falloff inside cursorRadius.
    float3 cursorForce = float3(0, 0, 0);
    if (_CursorOnScreen != 0u && s.cursorReactionStrength != 0.0f && s.cursorReactionRadius > 0.0f)
    {
        float3 toCursor = _CursorWorldPoint - selfPos;
        float distSqC = dot(toCursor, toCursor);
        float radSq = s.cursorReactionRadius * s.cursorReactionRadius;
        if (distSqC < radSq && distSqC > 1e-12f)
        {
            float invD = rsqrt(distSqC);
            float dist = distSqC * invD;
            float t = 1.0f - dist / s.cursorReactionRadius;
            float falloff = t * t * (3.0f - 2.0f * t);
            float magnitude = abs(s.cursorReactionStrength) * falloff;
            float sgn = s.cursorReactionStrength >= 0.0f ? 1.0f : -1.0f;
            cursorForce = toCursor * (invD * magnitude * sgn);
        }
    }

    float3 a = sep + ali + coh + boundsForce + hardBounds + cursorForce;

    // Cap acceleration.
    float maxASq = s.maxAcceleration * s.maxAcceleration;
    float aSq = dot(a, a);
    if (aSq > maxASq && aSq > 0.0f)
    {
        a = a * (s.maxAcceleration * rsqrt(aSq));
    }

    // Integrate, clamp speed.
    float3 vel = selfVel + a * _Dt;
    float speedSq2 = dot(vel, vel);
    float minSq = s.minSpeed * s.minSpeed;
    float maxSq = s.maxSpeed * s.maxSpeed;
    if (speedSq2 > maxSq && speedSq2 > 0.0f)
    {
        vel = vel * (s.maxSpeed * rsqrt(speedSq2));
    }
    else if (speedSq2 < minSq)
    {
        if (speedSq2 > 1e-12f)
        {
            vel = vel * (s.minSpeed * rsqrt(speedSq2));
        }
        else
        {
            vel = float3(0, 0, s.minSpeed);
        }
    }

    me.vel = vel;
    me.pos = selfPos + vel * _Dt;
    _Boids[i] = me;
}

// ──────────────────────────────────────────────────────────────────────────────
// CSBuildMatrices — write a TRS float4x4 per bird from pos+vel. Consumed by
// Graphics.RenderMeshIndirect in GpuIndirectFlockRenderer (no readback).
//
// Orientation: heading = normalize(vel), up = world up. Falls back to identity
// when vel is too short (the Steering pass guarantees vel.length ≥ MinSpeed
// post-clamp, so the fallback only fires for the very first frame before the
// first integrate step).
// ──────────────────────────────────────────────────────────────────────────────
[numthreads(64, 1, 1)]
void CSBuildMatrices(uint3 tid : SV_DispatchThreadID)
{
    uint i = tid.x;
    if (i >= _BirdCount) return;

    Boid b = _Boids[i];
    float3 fwd = b.vel;
    float speedSq = dot(fwd, fwd);
    if (speedSq < 1e-6f)
    {
        // Identity TRS at position.
        _Matrices[i] = float4x4(
            1, 0, 0, b.pos.x,
            0, 1, 0, b.pos.y,
            0, 0, 1, b.pos.z,
            0, 0, 0, 1);
        return;
    }
    fwd = fwd * rsqrt(speedSq);

    float3 worldUp = float3(0, 1, 0);
    float3 right = normalize(cross(worldUp, fwd));
    // If fwd ≈ ±worldUp, cross is degenerate — pick a stable fallback.
    if (dot(right, right) < 1e-6f)
    {
        right = float3(1, 0, 0);
    }
    float3 up = cross(fwd, right);

    // Column-major TRS: cols are (right, up, fwd, pos).
    _Matrices[i] = float4x4(
        right.x, up.x, fwd.x, b.pos.x,
        right.y, up.y, fwd.y, b.pos.y,
        right.z, up.z, fwd.z, b.pos.z,
        0,       0,    0,     1);
}
